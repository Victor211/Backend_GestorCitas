#####################################################
# Appointment Manager Backend
#####################################################
# Copiar este archivo a ".env" (o ".env.local") y completar los valores reales.
# Este archivo (.env.example) NO debe contener secretos, solo ejemplos.
# Ver docs/environment.md para el detalle completo de cada variable.

# Perfil activo: dev | prod | test
SPRING_PROFILES_ACTIVE=dev

# Bind del servidor HTTP embebido
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointment_manager
DB_USER=postgres
DB_PASSWORD=change-me

# Estrategia de schema de Hibernate (update | validate | none | create | create-drop)
HIBERNATE_DDL_AUTO=update

# JWT
JWT_SECRET=change-me
JWT_EXPIRATION=86400000

# CORS (orígenes permitidos, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI (motor conversacional)
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me

WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_BASE_URL=https://graph.facebook.com

WHATSAPP_CONNECT_TIMEOUT_MS=5000
WHATSAPP_READ_TIMEOUT_MS=15000

# Minutos de inactividad tras los cuales se considera abandonada una conversación de WhatsApp en
# curso (borrador de reserva y saludo se reinician; el Customer identificado por sender_phone no
# se toca). No es un secreto.
WHATSAPP_CONVERSATION_TIMEOUT_MINUTES=30
